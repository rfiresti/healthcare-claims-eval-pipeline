{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PolicyDocument",
  "type": "object",
  "properties": {
    "policy_id": { "type": "string", "pattern": "^POL-[0-9]{5}$" },
    "payer_name": { "type": "string" },
    "effective_date": { "type": "string", "format": "date" },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "clause_id": { "type": "string", "pattern": "^CLS-[0-9]{4}$" },
          "category": { "type": "string", "enum": ["Exclusion", "PreAuth", "Limitation", "MedicalNecessity"] },
          "clause_text": { "type": "string" }
        },
        "required": ["clause_id", "category", "clause_text"]
      }
    }
  },
  "required": ["policy_id", "payer_name", "effective_date", "clauses"]
}
